include https://raw.githubusercontent.com/codemonstur/bobfiles/master/foss-lib-github-maven

vendor: com.github.codemonstur
name: testrank
version: 0
release: 17
description: A maven plugin for quality checking tests
license:
  name: MIT
developer:
  name: Jurgen Voorneveld
  email: jegvoorneveld@gmail.com
enablePreview: false
packaging: maven-plugin
dependencies:
  - repository: commons-io:commons-io:2.14.0
  - repository: org.apache.maven:maven-plugin-api:3.6.3
    scope: provided
  - repository: org.apache.maven:maven-core:3.6.3
    scope: provided
  - repository: org.apache.maven.plugin-tools:maven-plugin-annotations:3.13.1
    scope: provided
  - repository: com.github.javaparser:javaparser-symbol-solver-core:3.28.2
  - repository: org.junit.jupiter:junit-jupiter:5.12.2
  - repository: io.github.openhtmltopdf:openhtmltopdf-pdfbox:1.1.86
  - repository: io.github.openhtmltopdf:openhtmltopdf-svg-support:1.1.86

build
 |  mvn clean package -DskipTests

update
 |  mvn validate -P vulnerabilities
 |  mvn validate -P licenses
